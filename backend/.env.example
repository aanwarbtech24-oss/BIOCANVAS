# BIOCANVAS Configuration Template
# Copy this file to .env and fill in your values

# ========================================
# BACKEND CONFIGURATION
# ========================================

# API Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
API_TITLE=BIOCANVAS API Server
API_VERSION=2.0.0

# Environment
DEBUG=false
LOG_LEVEL=info

# CORS (specify frontend URLs)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# File Upload Settings
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
UPLOAD_DIR=docking_jobs

# ========================================
# FRONTEND CONFIGURATION
# ========================================

# API Endpoints
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=BIOCANVAS
VITE_APP_VERSION=2.0.0

# ========================================
# OPTIONAL: DOCKING CONFIGURATION
# ========================================

# AutoDock Vina Path (if installed)
# VINA_PATH=/usr/local/bin/vina

# OpenBabel Path (if installed)
# OPENBABEL_PATH=/usr/local/bin/obabel

# Search Box Parameters (default calculations used if not specified)
# SEARCH_BOX_PADDING=5  # Angstroms

# ========================================
# OPTIONAL: DATABASE CONFIGURATION
# ========================================

# Future: if database integration is needed
# DATABASE_URL=sqlite:///./biocanvas.db
# DATABASE_POOL_SIZE=20

# ========================================
# OPTIONAL: AUTHENTICATION
# ========================================

# Future: if authentication is needed
# SECRET_KEY=your-secret-key-here
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION=3600
